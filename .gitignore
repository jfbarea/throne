# Dependencies
node_modules/

# Next.js
.next/
out/

# Build artifacts
dist/

# Environment variables — keep out of version control.
# Everything except the committed .env.example: the catch-all is deliberate so
# a new .env.<algo> (a staging target, a throwaway) is ignored by default
# rather than by remembering to add a line here.
.env
.env.*
!.env.example

# Prisma generated client
/src/generated/prisma

# SQLite database files
*.db
*.db-journal
*.db-shm
*.db-wal
prisma/dev.db
prisma/test.db

# Coverage
coverage/

# Generated documentation artifacts (regenerable from source)
SPEC.html

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo
PLAN.html

# Test/build artifacts
playwright-report/
test-results/
tsconfig.tsbuildinfo
docs/documentacion.html
