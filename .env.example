# Base de datos
# ─────────────────────────────────────────────────────────────────────────────
# Local / desarrollo / tests (SQLite en fichero):
DATABASE_URL="file:./dev.db"
#
# Producción con Turso (libSQL gestionado):
# DATABASE_URL="libsql://<nombre-db>-<org>.turso.io"
# ─────────────────────────────────────────────────────────────────────────────

# Token de autenticación de Turso
# Dejar vacío (o eliminar la línea) en local — no es necesario con file: URL
# En producción: ejecutar `turso db tokens create <nombre-db>` y pegar el resultado
DATABASE_AUTH_TOKEN=""

# Passcode del administrador (se compara con hash en servidor)
ADMIN_PASSCODE="change-me"

# Secreto para firmar las cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
